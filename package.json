{
  "name": "libdegiro",
  "version": "0.1.0",
  "description": "Parse DEGIRO broker account statement (Account.csv) exports into a typed, extensible domain model.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "keywords": [
    "degiro",
    "broker",
    "csv",
    "parser",
    "account-statement",
    "finance",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.browser.js",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run",
    "test:watch": "pnpm build && vitest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "big.js": "^6.2.2",
    "csv-parse": "^5.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/big.js": "^6.2.2",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
