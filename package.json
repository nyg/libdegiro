{
  "name": "libdegiro",
  "version": "0.1.1",
  "description": "Parse DEGIRO broker account statement (Account.csv) exports into a typed, extensible domain model.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "nyg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nyg/libdegiro.git"
  },
  "homepage": "https://github.com/nyg/libdegiro#readme",
  "bugs": {
    "url": "https://github.com/nyg/libdegiro/issues"
  },
  "keywords": [
    "degiro",
    "broker",
    "csv",
    "parser",
    "account-statement",
    "finance",
    "typescript"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.browser.js",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run",
    "test:watch": "pnpm build && vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepublishOnly": "pnpm test",
    "dashboard:dev": "pnpm --filter @libdegiro/dashboard dev",
    "dashboard:build": "pnpm --filter @libdegiro/dashboard build",
    "dashboard:test": "pnpm --filter @libdegiro/dashboard test",
    "dashboard:typecheck": "pnpm --filter @libdegiro/dashboard typecheck"
  },
  "dependencies": {
    "big.js": "7.0.1",
    "csv-parse": "7.0.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/big.js": "7.0.0",
    "@types/node": "26.2.0",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
