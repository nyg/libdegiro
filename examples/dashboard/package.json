{
  "name": "@libdegiro/dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Client-side DEGIRO Account.csv dashboard — an example consumer of libdegiro.",
  "scripts": {
    "dev": "pnpm --filter libdegiro build && vite",
    "build": "pnpm --filter libdegiro build && vite build",
    "preview": "vite preview",
