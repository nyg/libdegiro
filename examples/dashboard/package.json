    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "idb-keyval": "6.2.2",
    "libdegiro": "workspace:*",
    "lucide-react": "0.545.0",
    "radix-ui": "1.6.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "3.8.0",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.14",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "5.0.4",
    "tailwindcss": "4.1.14",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "7.1.9",
    "vitest": "4.1.10"
  }
}
